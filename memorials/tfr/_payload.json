[{"data":1,"prerenderedAt":113},["ShallowReactive",2],{"memorial-/memorials/tfr/":3,"fallentfr":35},{"id":4,"title":5,"body":6,"description":12,"ext_link":26,"extension":27,"meta":28,"navigation":30,"path":31,"seo":32,"stem":33,"__hash__":34},"memorials/memorials/tfr.md","City of Tampa Fire Rescue",{"type":7,"value":8,"toc":22},"minimark",[9,13],[10,11,12],"p",{},"Tampa Fire Rescue provides essential service in the areas of fire prevention, fire protection, fire suppression services and emergency medical services for the seriously ill and injured. Tampa Fire Rescue also provides hazardous materials response, aircraft rescue, marine firefighting and fire and life safety education to the public. The Fire Marshal’s office, a division of Tampa Fire Rescue, investigates causes of fire, conducts building code reviews and enforces fire and life safety codes.",[10,14,15],{},[16,17,21],"a",{"href":18,"rel":19},"http://www.tampagov.net/dept_fire_and_police_pension/information_resources/memorial.asp",[20],"nofollow","Learn more about the Tampa Fire & Police Memorial",{"title":23,"searchDepth":24,"depth":24,"links":25},"",2,[],"http://www.tampagov.net/dept_fire_rescue/","md",{"permalink":29},"tfr",true,"/memorials/tfr",{"title":5,"description":12},"memorials/tfr","I0qIDqP3Kd0SexFDH6zLoARVnw3kepERBUeetSUEpRk",[36,42,47,51,56,61,65,70,75,80,85,89,94,99,104,109],{"id":37,"name":38,"path":39,"image":40,"dob":40,"date":41,"circa":30},"fallen/memorials/tfr/2001-01-01-jack-barker.md","Jack Barker","/memorials/tfr/2001-01-01-jack-barker",null,"2001-01-01",{"id":43,"name":44,"path":45,"image":40,"dob":40,"date":46,"circa":30},"fallen/memorials/tfr/1981-01-01-franz-g-warner.md","Franz G. Warner","/memorials/tfr/1981-01-01-franz-g-warner","1981-01-01",{"id":48,"name":49,"path":50,"image":40,"dob":40,"date":46,"circa":30},"fallen/memorials/tfr/1981-01-01-isaac-royal.md","Isaac Royal","/memorials/tfr/1981-01-01-isaac-royal",{"id":52,"name":53,"path":54,"image":40,"dob":40,"date":55,"circa":