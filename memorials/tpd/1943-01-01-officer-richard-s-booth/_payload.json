[{"data":1,"prerenderedAt":35},["ShallowReactive",2],{"fallen-/memorials/tpd/1943-01-01-officer-richard-s-booth/":3,"memorial-tpd":32},{"id":4,"title":5,"body":6,"category":20,"circa":21,"date":22,"description":12,"dob":23,"extension":24,"image":25,"meta":26,"name":27,"navigation":21,"path":28,"seo":29,"stem":30,"__hash__":31},"fallen/memorials/tpd/1943-01-01-officer-richard-s-booth.md","1943 01 01 Officer Richard S Booth",{"type":7,"value":8,"toc":16},"minimark",[9,13],[10,11,12],"p",{},"Officer Booth was killed in a motorcycle accident at Louisiana Avenue and 11th Street while pursuing a vehicle. His bike flipped over when he struck a dip in the pavement.",[10,14,15],{},"Officer Booth was survived by his wife, daughter, and two sons.",{"title":17,"searchDepth":18,"depth":18,"links":19},"",2,[],"tpd",true,"1943-01-01",null,"md","/uploads/officer-richard-s-booth-1.jpg",{},"Officer Richard S. Booth","/memorials/tpd/1943-01-01-officer-richard-s-booth",{"description":12},"memorials/tpd/1943-01-01-officer-richard-s-booth","2qBrn_L7JHf4A__iENHUsuOLWM6EqYUh769y_5aYMNY",{"title":33,"path":34},"City of Tampa Police Department","/memorials/tpd",1770822355712]