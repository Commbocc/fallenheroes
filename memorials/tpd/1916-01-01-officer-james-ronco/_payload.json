[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"fallen-/memorials/tpd/1916-01-01-officer-james-ronco/":3,"memorial-tpd":29},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":22,"meta":23,"name":24,"navigation":18,"path":25,"seo":26,"stem":27,"__hash__":28},"fallen/memorials/tpd/1916-01-01-officer-james-ronco.md","1916 01 01 Officer James Ronco",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Officer Ronco was shot and killed by a female prisoner who had just escaped from the police station. While he was transporting her back to jail she grabbed his gun and shot him twice. He was able to regain control of the weapon and shot and killed the suspect as well. It was determined that the suspect was under the influence of heroin and cocaine.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1916-01-01",null,"md","/uploads/officer-james-ronco-1.jpg",{},"Officer James Ronco","/memorials/tpd/1916-01-01-officer-james-ronco",{"description":12},"memorials/tpd/1916-01-01-officer-james-ronco","yDu_pBch7MAJq3z4-w00cueHRk_IacYTe7tjs8rxAr4",{"title":30,"path":31},"City of Tampa Police Department","/memorials/tpd",1770758533797]