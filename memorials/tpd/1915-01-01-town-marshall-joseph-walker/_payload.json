[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"fallen-/memorials/tpd/1915-01-01-town-marshall-joseph-walker/":3,"memorial-tpd":34},{"id":4,"title":5,"body":6,"category":23,"circa":24,"date":25,"description":12,"dob":26,"extension":27,"image":26,"meta":28,"name":29,"navigation":24,"path":30,"seo":31,"stem":32,"__hash__":33},"fallen/memorials/tpd/1915-01-01-town-marshall-joseph-walker.md","1915 01 01 Town Marshall Joseph Walker",{"type":7,"value":8,"toc":19},"minimark",[9,13,16],[10,11,12],"p",{},"City Marshal Joseph Walker was shot and killed while responding to a domestic disturbance. As he approached the suspect, the man opened fire, killing Marshal Walker.",[10,14,15],{},"An officer with Marshal Walker was shot and wounded. The suspect was apprehended three days later.",[10,17,18],{},"Marshal Walker had served with the agency for 16 years. He was survived by his wife.",{"title":20,"searchDepth":21,"depth":21,"links":22},"",2,[],"tpd",true,"1915-01-01",null,"md",{},"Town Marshall Joseph Walker","/memorials/tpd/1915-01-01-town-marshall-joseph-walker",{"description":12},"memorials/tpd/1915-01-01-town-marshall-joseph-walker","_AgAb1jhhzFTs9fG5ct1Ta_iGoI6m5LGwMNSxlQ33bs",{"title":35,"path":36},"City of Tampa Police Department","/memorials/tpd",1770761115071]