[{"data":1,"prerenderedAt":35},["ShallowReactive",2],{"fallen-/memorials/tpd/1981-01-01-detective-gerald-a-rauft":3,"memorial-tpd":32},{"id":4,"title":5,"body":6,"category":20,"circa":21,"date":22,"description":12,"dob":23,"extension":24,"image":25,"meta":26,"name":27,"navigation":21,"path":28,"seo":29,"stem":30,"__hash__":31},"fallen/memorials/tpd/1981-01-01-detective-gerald-a-rauft.md","1981 01 01 Detective Gerald A Rauft",{"type":7,"value":8,"toc":16},"minimark",[9,13],[10,11,12],"p",{},"Detective Rauft was shot and killed during an undercover operation to purchase 100 pounds of marijuana. During the deal a shootout erupted and Detective Rauft was fatally wounded. Four suspects were apprehended.",[10,14,15],{},"Detective Rauft had been with the agency for eight years.",{"title":17,"searchDepth":18,"depth":18,"links":19},"",2,[],"tpd",true,"1981-01-01",null,"md","/uploads/detective-gerald-a-rauft-1.jpg",{},"Detective Gerald A. Rauft","/memorials/tpd/1981-01-01-detective-gerald-a-rauft",{"description":12},"memorials/tpd/1981-01-01-detective-gerald-a-rauft","bIjHF-hri0v8q3j17WI_supSynOW84XXsYjmPjZvV_Y",{"title":33,"path":34},"City of Tampa Police Department","/memorials/tpd",1770659988903]