[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"fallen-/memorials/tpd/1949-01-01-officer-morris-d-lopez/":3,"memorial-tpd":29},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":22,"meta":23,"name":24,"navigation":18,"path":25,"seo":26,"stem":27,"__hash__":28},"fallen/memorials/tpd/1949-01-01-officer-morris-d-lopez.md","1949 01 01 Officer Morris D Lopez",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Patrolman Lopez was shot and killed by unknown assailants at 7th Avenue and 16th Street in Ybor City while on foot patrol. A vehicle suddenly stopped and a shot rang out, striking Patrolman Lopez in the chest. No suspects were ever identified and the case remains open.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1949-01-01",null,"md","/uploads/officer-morris-d-lopez-1.jpg",{},"Officer Morris D. Lopez","/memorials/tpd/1949-01-01-officer-morris-d-lopez",{"description":12},"memorials/tpd/1949-01-01-officer-morris-d-lopez","9CvzjyFw5DpdGWNixaflqcyxspWkBnAgoWhcrmNzMi0",{"title":30,"path":31},"City of Tampa Police Department","/memorials/tpd",1770761114826]