[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"fallen-/memorials/tpd/1905-01-01-captain-samuel-carter":3,"memorial-tpd":29},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":22,"meta":23,"name":24,"navigation":18,"path":25,"seo":26,"stem":27,"__hash__":28},"fallen/memorials/tpd/1905-01-01-captain-samuel-carter.md","1905 01 01 Captain Samuel Carter",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Captain Carter was shot and killed as he searched for a man who was threatening a woman with a gun. During the search the suspect jumped from behind some bushes and shot Captain Carter from approximately ten feet away. Captain Carter succumbed to his wounds three days later.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1905-01-01",null,"md","/uploads/captain-samuel-carter-1.jpg",{},"Captain Samuel Carter","/memorials/tpd/1905-01-01-captain-samuel-carter",{"description":12},"memorials/tpd/1905-01-01-captain-samuel-carter","Xz4Z6EwuKAKpvQoXgk_t5wby9Q9acMvJjT3bSaj4Be0",{"title":30,"path":31},"City of Tampa Police Department","/memorials/tpd",1770659518524]