[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"fallen-/memorials/tpd/1922-01-01-officer-henry-lett":3,"memorial-tpd":29},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":22,"meta":23,"name":24,"navigation":18,"path":25,"seo":26,"stem":27,"__hash__":28},"fallen/memorials/tpd/1922-01-01-officer-henry-lett.md","1922 01 01 Officer Henry Lett",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Officer Lett was shot and killed as he and his partner attempted to arrest a man for disorderly conduct. The officers had responded to a call of a man threatening to shoot a woman. As they approached him he ran into an alley and drew his weapon. Officer Lett returned fire at the same time and both were wounded. Officer Lett later succumbed to his wounds.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1922-01-01",null,"md","/uploads/officer-henry-lett-1.jpg",{},"Officer Henry Lett","/memorials/tpd/1922-01-01-officer-henry-lett",{"description":12},"memorials/tpd/1922-01-01-officer-henry-lett","vJM_sSZUk1aqsaPtQjDhNtrP09mlBqyr4RZhuzLcptQ",{"title":30,"path":31},"City of Tampa Police Department","/memorials/tpd",1770659989232]