[{"data":1,"prerenderedAt":31},["ShallowReactive",2],{"fallen-/memorials/tpd/1939-01-01-detective-joe-nance/":3,"memorial-tpd":28},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":20,"meta":22,"name":23,"navigation":18,"path":24,"seo":25,"stem":26,"__hash__":27},"fallen/memorials/tpd/1939-01-01-detective-joe-nance.md","1939 01 01 Detective Joe Nance",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Detective Nance succumbed to injuries received one week earlier when his vehicle was involved in an accident. He was en route to Lakeland to conduct an interview when a truck forced his vehicle off the road.\nDetective Nance had been with the agency for 18 years.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1939-01-01",null,"md",{},"Detective Joe Nance","/memorials/tpd/1939-01-01-detective-joe-nance",{"description":12},"memorials/tpd/1939-01-01-detective-joe-nance","gk-QJEDH8m23uUwWtKCjZLa-lK5DXPJ58EisD118bZI",{"title":29,"path":30},"City of Tampa Police Department","/memorials/tpd",1770822355773]