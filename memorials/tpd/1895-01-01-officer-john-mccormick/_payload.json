[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"fallen-/memorials/tpd/1895-01-01-officer-john-mccormick":3,"memorial-tpd":29},{"id":4,"title":5,"body":6,"category":17,"circa":18,"date":19,"description":12,"dob":20,"extension":21,"image":22,"meta":23,"name":24,"navigation":18,"path":25,"seo":26,"stem":27,"__hash__":28},"fallen/memorials/tpd/1895-01-01-officer-john-mccormick.md","1895 01 01 Officer John Mccormick",{"type":7,"value":8,"toc":13},"minimark",[9],[10,11,12],"p",{},"Patrolman McCormick was shot and killed while arresting a female suspect at a local bar. During the arrest the woman's boyfriend approached the officers and shot Patrolman McCormick in the stomach. His partner returned fire but missed the suspect. The man was apprehended several weeks later.",{"title":14,"searchDepth":15,"depth":15,"links":16},"",2,[],"tpd",true,"1895-01-01",null,"md","/uploads/officer-john-mccormick-1.jpg",{},"Officer John McCormick","/memorials/tpd/1895-01-01-officer-john-mccormick",{"description":12},"memorials/tpd/1895-01-01-officer-john-mccormick","-aNr5avZLevMoiIwdkHPKB5riBkLTuX676GDQiOz4W4",{"title":30,"path":31},"City of Tampa Police Department","/memorials/tpd",1770659518526]