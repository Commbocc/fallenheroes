[{"data":1,"prerenderedAt":52},["ShallowReactive",2],{"fallen-/memorials/hcfr/2005-09-29-firefighter-gregory-reeher/":3,"memorial-hcfr":49},{"id":4,"title":5,"body":6,"category":36,"circa":37,"date":38,"description":12,"dob":39,"extension":40,"image":41,"meta":42,"name":43,"navigation":44,"path":45,"seo":46,"stem":47,"__hash__":48},"fallen/memorials/hcfr/2005-09-29-firefighter-gregory-reeher.md","2005 09 29 Firefighter Gregory Reeher",{"type":7,"value":8,"toc":32},"minimark",[9,13,16],[10,11,12],"p",{},"Firefighter Gregory Reeher was born in Rochester, Pennsylvania. He was a firefighter for Pasco County for two years and Hillsborough County Fire Rescue for 21 years.",[10,14,15],{},"He was married to Sara Reeher and together they had two daughters, Casey and Kayleigh. His daughter Kayleigh Cooper says that friends and family remember Firefighter Reeher as a man dedicated to his family and his community. He was a Harley-Davidson rider, who loved his dog, and talking about history and trips to England.",[17,18,19],"ul",{},[20,21,22,31],"li",{},[23,24,27],"a",{"href":25,"target":26},"/media/copter-crashes-into-roof.pdf","_blank",[28,29,30],"strong",{},"Copter Crashes into Roof"," - St. Petersburg Times Article, June 4, 2002",{"title":33,"searchDepth":34,"depth":34,"links":35},"",2,[],"hcfr",false,"2005-09-29","1951-09-17","md","/uploads/firefighter-gregory-reeher-1.jpg",{},"Firefighter Gregory Reeher",true,"/memorials/hcfr/2005-09-29-firefighter-gregory-reeher",{"description":12},"memorials/hcfr/2005-09-29-firefighter-gregory-reeher","FMJo9IQVxr7yHCy4rcG7-YkWEfC8WjXlqpIWYZ5VN_s",{"title":50,"path":51},"Hillsborough County Fire Rescue","/memorials/hcfr",1770758533029]