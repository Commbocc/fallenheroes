[{"data":1,"prerenderedAt":51},["ShallowReactive",2],{"fallen-/memorials/hcfr/2005-09-29-firefighter-gregory-reeher":3,"memorial-hcfr":48},{"id":4,"title":5,"body":6,"category":35,"circa":36,"date":37,"description":12,"dob":38,"extension":39,"image":40,"meta":41,"name":42,"navigation":43,"path":44,"seo":45,"stem":46,"__hash__":47},"fallen/memorials/hcfr/2005-09-29-firefighter-gregory-reeher.md","2005 09 29 Firefighter Gregory Reeher",{"type":7,"value":8,"toc":31},"minimark",[9,13,16],[10,11,12],"p",{},"Firefighter Gregory Reeher was born in Rochester, Pennsylvania. He was a firefighter for Pasco County for two years and Hillsborough County Fire Rescue for 21 years.",[10,14,15],{},"He was married to Sara Reeher and together they had two daughters, Casey and Kayleigh. His daughter Kayleigh Cooper says that friends and family remember Firefighter Reeher as a man dedicated to his family and his community. He was a Harley-Davidson rider, who loved his dog, and talking about history and trips to England.",[17,18,19],"ul",{},[20,21,22,30],"li",{},[23,24,26],"a",{"href":25},"/media/copter-crashes-into-roof.pdf",[27,28,29],"strong",{},"Copter Crashes into Roof"," - St. Petersburg Times Article, June 4, 2002",{"title":32,"searchDepth":33,"depth":33,"links":34},"",2,[],"hcfr",false,"2005-09-29","1951-09-17","md","/uploads/firefighter-gregory-reeher-1.jpg",{},"Firefighter Gregory Reeher",true,"/memorials/hcfr/2005-09-29-firefighter-gregory-reeher",{"description":12},"memorials/hcfr/2005-09-29-firefighter-gregory-reeher","l6FzEnhQ-oETYXk4MqXp_mwz0ft5XuqIOfizonOwRVQ",{"title":49,"path":50},"Hillsborough County Fire Rescue","/memorials/hcfr",1770659517700]